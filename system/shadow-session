#!/bin/sh
# Shadow TUI Restricted session (started by greetd through shadow-greet, or from a TTY).
#
# shadow-compositor (Shadow's own Smithay compositor, 10.0: the only one) reads
# ~/.config/shadow-state/config.toml itself and starts the Shadow session services and the shell
# panels ([autostart]).
#
# Memory: the compositor and the Shadow apps run in the user unit shadow.slice (memory.high 13 %,
# memory.max 16 % of RAM); the system daemons have the other 4 % in the system shadow.slice:
# together <= 20 % (spec §3.4). Programs you start go to app.slice and keep the other 80 %.
export XDG_CURRENT_DESKTOP=shadow XDG_SESSION_DESKTOP=shadow-tui XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1 QT_QPA_PLATFORM="wayland;xcb" SDL_VIDEODRIVER="wayland,x11" ELECTRON_OZONE_PLATFORM_HINT=auto
# Java (AWT/Swing: JetBrains IDEs, …) draws blank grey windows on non-reparenting compositors
export _JAVA_AWT_WM_NONREPARENTING=1
# OpenGL only, no Vulkan, for the whole session. The Arc 140V (Lunar Lake / Xe2) runs on the
# xe kernel driver with Mesa iris for OpenGL; the compositor renders with OpenGL ES through EGL.
# GTK >= 4.16 and Qt 6 would otherwise pick Vulkan on their own. Override in
# ~/.config/shadow-state/session.env if you ever want it back.
export GSK_RENDERER=ngl QSG_RHI_BACKEND=opengl
[ -f /usr/share/glvnd/egl_vendor.d/50_mesa.json ] && export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
# /usr/local/bin: greetd built from source on RHEL 9
export PATH="/opt/shadow-tui/bin:/usr/local/bin:$PATH"
STATE=${SHADOW_STATE:-${XDG_CONFIG_HOME:-$HOME/.config}/shadow-state}
[ -f "$STATE/session.env" ] && . "$STATE/session.env"
LOG=${XDG_STATE_HOME:-$HOME/.local/state}/shadow-tui/session.log
mkdir -p "$(dirname "$LOG")" "$STATE"

# failsafe: never start the desktop on a half-updated system. The marker exists from the first
# file an update changes until the last one is on disk (or an interrupted update is recovered).
MARK=/var/lib/shadow-tui/update-in-progress
update_gate() {
    [ -e "$MARK" ] || return 0
    echo "$(date -Is) refused to start: $MARK exists ($(tr '\n' ' ' <"$MARK" 2>/dev/null))" >>"$LOG"
    cat >&2 <<'MSG'
Shadow TUI: a system update is in progress, or one was interrupted.
The desktop will not start until it has finished, so it never runs on half-replaced files.
  - wait for the update to finish, then log in again;
  - or reboot: an interrupted update is finished or reversed automatically before the login screen;
  - or, on a text console:  sudo shadow update recover
MSG
    [ -t 2 ] && sleep 3
    exit 75
}
update_gate

# first login: per-user setup (the compositor reads config.toml itself)
[ -f "$STATE/config.toml" ] || /opt/shadow-tui/bin/shadow setup --yes >>"$LOG" 2>&1
# automatic updates: the user timer (or a one-off check without systemd)
( /opt/shadow-tui/bin/shadow update login-check >>"$LOG" 2>&1 & )

run() {
    if command -v systemd-run >/dev/null 2>&1 && systemctl --user show-environment >/dev/null 2>&1; then
        systemctl --user import-environment XDG_CURRENT_DESKTOP XDG_SESSION_TYPE GSK_RENDERER QSG_RHI_BACKEND PATH 2>/dev/null
        systemd-run --user --scope --slice=shadow.slice --collect --quiet -- "$@"
    else
        "$@"
    fi
}
update_gate

if ! command -v shadow-compositor >/dev/null 2>&1; then
    echo "$(date -Is) shadow-compositor is not installed — reinstall Shadow TUI (./install.sh)" >>"$LOG"
    echo "Shadow TUI: shadow-compositor is missing. Reinstall with ./install.sh (or your package manager)." >&2
    [ -t 2 ] && sleep 3
    exit 1
fi

# WSL (Windows Subsystem for Linux): no DRM, no greetd, no laptop hardware. The compositor runs as a
# window on the Windows desktop through WSLg (it detects WAYLAND_DISPLAY and goes nested), and
# hardware services are left alone.
if grep -qiE 'microsoft|wsl' /proc/sys/kernel/osrelease 2>/dev/null; then
    export SHADOW_WSL=1
    echo "$(date -Is) WSL detected: running as a window on the Windows desktop" >>"$LOG"
    if [ -z "$WAYLAND_DISPLAY" ] && [ -S /mnt/wslg/runtime-dir/wayland-0 ]; then
        export WAYLAND_DISPLAY=wayland-0
        [ -n "$XDG_RUNTIME_DIR" ] || export XDG_RUNTIME_DIR=/mnt/wslg/runtime-dir
    fi
    if [ -z "$WAYLAND_DISPLAY" ] && [ -z "$DISPLAY" ]; then
        echo "Shadow TUI on WSL needs WSLg (Windows 11, or Windows 10 with WSL from the Microsoft Store): no Wayland or X display found." >&2
        exit 1
    fi
fi

run shadow-compositor 2>>"$LOG"
