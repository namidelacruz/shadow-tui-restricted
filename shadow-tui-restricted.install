# pacman scriptlets: the logic is shared with the RPM in packaging/post-install.sh
post_install()  { /opt/shadow-tui/lib/post-install.sh install; }
post_upgrade()  { /opt/shadow-tui/lib/post-install.sh upgrade; }
pre_remove()    { /opt/shadow-tui/lib/post-install.sh pre-remove; }
post_remove()   { echo "==> Your state (~/.config/shadow-state) and /var/lib/shadow-tui/modules are kept."; }
